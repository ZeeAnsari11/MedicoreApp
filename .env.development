# Loaded by `npx expo start` (development mode). EXPO_PUBLIC_ values are inlined into the JS bundle: never put secrets here.
# Android emulator -> the API on your Mac (`pnpm local` in the Medicore repo):
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
# Physical phone on the same Wi-Fi: don't edit this file; put
#   EXPO_PUBLIC_API_URL=http://<your-mac-lan-ip>:4000/api
# in .env.development.local (git-ignored), which takes precedence.
