# Expo SDK 58 loads only .env, .env.local, .env.development / .env.production and their .local variants
# (.env.staging etc. are ignored). .env.development is committed with the emulator URL; put machine-specific values
# in .env.development.local (git-ignored). EAS builds take the URL from the profile's env in eas.json.
# Android emulator -> your Mac:      http://10.0.2.2:4000/api
# Physical device on the same Wi-Fi: http://<your-mac-lan-ip>:4000/api
# Production:                        https://<your-api-host>/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
